{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mokka-ecu-lab:definition-contribution:1",
  "title": "Future local definition-only contribution format",
  "description": "No publisher or network endpoint. Excludes identity, raw evidence, source ECU identifiers and journey data. Requires human source review before any future contribution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_id",
    "service",
    "pid",
    "length",
    "formula",
    "units",
    "signed",
    "flags",
    "sentinel",
    "references",
    "revision",
    "evidence_state",
    "verification_method",
    "test_provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "definition_id": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "pattern": "^[0-9A-F]{2}$"
    },
    "pid": {
      "type": "string",
      "pattern": "^[0-9A-F]{2,4}$"
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4095
    },
    "formula": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "string",
      "minLength": 1
    },
    "signed": {
      "type": "boolean"
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sentinel": {
      "type": [
        "string",
        "null"
      ]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "evidence_state": {
      "const": "INDEPENDENTLY_VERIFIED"
    },
    "verification_method": {
      "type": "string",
      "minLength": 1
    },
    "test_provenance": {
      "type": "string",
      "minLength": 1
    }
  }
}
